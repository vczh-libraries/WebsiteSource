<Instance ref.CodeBehind="false"
          ref.Class="demo::TestWindow">
  <Window Text="Say hello"
          ClientSize="x:360 y:0" SizeBox="false"
          MinimizedBox="false" MaximizedBox="false">
    <ez:Layout Padding="5">
      <ez:Top>
        <Label Text="Your name"/>
      </ez:Top>
      <ez:Top>
        <SinglelineTextBox ref.Name="nameInput"
                           Text="world">
          <att.BoundsComposition-set PreferredMinSize="x:0 y:26"/>
        </SinglelineTextBox>
      </ez:Top>
      <ez:Top>
        <Label
          Text-format="Hello, $(nameInput.Text)!"/>
      </ez:Top>
    </ez:Layout>
  </Window>
</Instance>
